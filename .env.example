# === Application ===
APP_NAME=DocIntel
DEBUG=false
SECRET_KEY=change-me-to-a-random-64-char-string
JWT_EXPIRY_MINUTES=60

# === Database ===
DATABASE_URL=postgresql+asyncpg://docintel:docintel@db:5432/docintel
DATABASE_URL_SYNC=postgresql://docintel:docintel@db:5432/docintel

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === LLM ===
EXTRACTOR=fake
LLM_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-2.0-flash
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
LLM_CONCURRENCY=4

# === Upload limits ===
MAX_UPLOAD_SIZE_MB=50
MAX_PAGES=200

# === Processing ===
RENDER_DPI=200
MIN_TEXT_CHARS=50
CELERY_CONCURRENCY=4

# === Confidence thresholds ===
CONFIDENCE_HIGH=0.80
CONFIDENCE_LOW=0.50

# === Rate limiting ===
LOGIN_RATE_LIMIT=10/minute
UPLOAD_RATE_LIMIT=20/minute

# === Storage ===
UPLOAD_DIR=/app/uploads
